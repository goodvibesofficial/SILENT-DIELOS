--------------------------------------------------------------------------------
-- 4. SISTEMA DE SILENT AIM DEFINITIVO PARA TABLET (Touch & Camera Hooks)
--------------------------------------------------------------------------------
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")
local Camera = Workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer

-- Configuraciones Avanzadas para Tablet
local settings = {
    aimbotEnabled = true,
    predictionEnabled = true,
    predictionAmount = 0.15, -- Ajustable para compensar la latencia en tablets
    wallCheck = true
}

-- Función de Predicción de Movimiento (Vital para objetivos en movimiento en pantallas táctiles)
local function getPredictedPosition(targetPart)
    if settings.predictionEnabled and targetPart and targetPart.Parent then
        local velocity = targetPart.AssemblyLinearVelocity
        if velocity.Magnitude > 0 then
            return targetPart.Position + (velocity * settings.predictionAmount)
        end
    end
    return targetPart and targetPart.Position or Vector3.new(0,0,0)
end

local mt = getrawmetatable(game)
local oldNamecall = mt.__namecall
setreadonly(mt, false)

--------------------------------------------------------------------------------
-- NAMECALL HOOK (Optimizado para Tableta / Pantallas Táctiles)
--------------------------------------------------------------------------------
mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local args = {...}

    if not checkcaller() and settings.aimbotEnabled then
        local target = getClosestEnemyLegit() -- Tu función de selección de objetivo
        
        if target then
            local predictedPos = getPredictedPosition(target)

            -- 1. INTERCEPCIÓN TÁCTIL / CÁMARA (Cuando tocas la pantalla de la tablet)
            -- Los juegos de tablet usan la cámara para proyectar el toque del dedo al mundo 3D.
            if self == Camera and (method == "ScreenPointToRay" or method == "ViewportPointToRay") then
                local origin = Camera.CFrame.Position
                local direction = (predictedPos - origin).Unit
                -- Forzamos a que cualquier toque devuelva un rayo directo al enemigo
                return Ray.new(origin, direction)
            end

            -- 2. INTERCEPCIÓN DE RAYCASTS DEL MOTOR DEL JUEGO (Workspace:Raycast)
            if method == "Raycast" then
                local origin = args[1]
                local direction = (predictedPos - origin).Unit * 1000 
                args[2] = direction
                return oldNamecall(self, unpack(args))
            
            -- 3. INTERCEPCIÓN LEGACY (FindPartOnRay para juegos más antiguos)
            elseif method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRayWithWhitelist" then
                local origin = args[1].Origin
                local direction = (predictedPos - origin).Unit * 1000
                args[1] = Ray.new(origin, direction)
                return oldNamecall(self, unpack(args))
            end
            
            -- 4. INTERCEPCIÓN DE REMOTES (FireServer para botones de disparo en UI de Tablet)
            if method == "FireServer" then
                local remoteName = tostring(self.Name):lower()
                -- Detecta eventos típicos de armas en juegos móviles (Shoot, Fire, GunEvent, Combat)
                if remoteName:match("shoot") or remoteName:match("fire") or remoteName:match("attack") or remoteName:match("bullet") then
                    for i, v in pairs(args) do
                        -- Si el juego manda la posición del toque o dirección de bala, la reemplazamos por el blanco
                        if typeof(v) == "Vector3" then
                            args[i] = predictedPos
                        elseif typeof(v) == "CFrame" then
                            args[i] = CFrame.new(predictedPos)
                        end
                    end
                    return oldNamecall(self, unpack(args))
                end
            end
        end
    end

    return oldNamecall(self, unpack(args))
end)
setreadonly(mt, true)


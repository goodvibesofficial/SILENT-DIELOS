-- ============================================================================
-- TEAM CHECK FUNCTION
-- ============================================================================
local function isEnemy(player)
    if player == LocalPlayer then return false end
    if not player.Character then return false end
    
    if LocalPlayer.Team and player.Team then
        return player.Team ~= LocalPlayer.Team
    end
    
    return true
end

-- ============================================================================
-- SILENT AIM & TABLET OPTIMIZATION HOOKS
-- ============================================================================
local settings = {
    predictionEnabled = true,
    predictionAmount = 0.15
}

local function getPredictedPosition(targetPart)
    if settings.predictionEnabled and targetPart and targetPart.Parent then
        local velocity = targetPart.AssemblyLinearVelocity
        if velocity.Magnitude > 0 then
            return targetPart.Position + (velocity * settings.predictionAmount)
        end
    end
    return targetPart and targetPart.Position or Vector3.new(0,0,0)
end

local function getClosestEnemyHead()
    local closestTarget = nil
    local shortestDist = math.huge
    
    for _, player in ipairs(Players:GetPlayers()) do
        if isEnemy(player) then
            local char = player.Character
            if char and char:FindFirstChild("Head") and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
                local head = char.Head
                local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                
                if onScreen then
                    local touchPos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - touchPos).Magnitude
                    
                    if dist < shortestDist and dist < 350 then
                        shortestDist = dist
                        closestTarget = head
                    end
                end
            end
        end
    end
    
    return closestTarget
end

local mt = getrawmetatable(game)
local oldNamecall = mt.__namecall
setreadonly(mt, false)

mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local args = {...}

    if not checkcaller() and silentAimEnabled then
        local targetHead = getClosestEnemyHead()
        
        if targetHead then
            local predictedPos = getPredictedPosition(targetHead)

            if self == Camera and (method == "ScreenPointToRay" or method == "ViewportPointToRay") then
                local origin = Camera.CFrame.Position
                local direction = (predictedPos - origin).Unit
                return Ray.new(origin, direction)
            end

            if method == "Raycast" then
                local origin = args[1]
                local direction = (predictedPos - origin).Unit * 1000 
                args[2] = direction
                return oldNamecall(self, unpack(args))
            
            elseif method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRayWithWhitelist" then
                local origin = args[1].Origin
                local direction = (predictedPos - origin).Unit * 1000
                args[1] = Ray.new(origin, direction)
                return oldNamecall(self, unpack(args))
            end
            
            if method == "FireServer" then
                local remoteName = tostring(self.Name):lower()
                if remoteName:match("shoot") or remoteName:match("fire") or remoteName:match("attack") or remoteName:match("bullet") then
                    for i, v in pairs(args) do
                        if typeof(v) == "Vector3" then
                            args[i] = predictedPos
                        elseif typeof(v) == "CFrame" then
                            args[i] = CFrame.new(predictedPos)
                        end
                    end
                    return oldNamecall(self, unpack(args))
                end
            end
        end
    end

    return oldNamecall(self, unpack(args))
end)
setreadonly(mt, true)

-- ============================================================================
-- SKELETON ESP LOGIC (Random Neon Colors & Team Filter)
-- ============================================================================
local NEON_COLORS = {
    Color3.fromRGB(192, 38, 211),
    Color3.fromRGB(56, 189, 248),
    Color3.fromRGB(52, 211, 153),
    Color3.fromRGB(244, 114, 182),
    Color3.fromRGB(251, 191, 36),
    Color3.fromRGB(129, 140, 248),
    Color3.fromRGB(236, 72, 153)
}

local function getRandomNeonColor()
    return NEON_COLORS[math.random(1, #NEON_COLORS)]
end

local activeSkeletons = {}

local R15_BONES = {
    {"Head", "UpperTorso"},
    {"UpperTorso", "LowerTorso"},
    {"UpperTorso", "LeftUpperArm"},
    {"LeftUpperArm", "LeftLowerArm"},
    {"LeftLowerArm", "LeftHand"},
    {"UpperTorso", "RightUpperArm"},
    {"RightUpperArm", "RightLowerArm"},
    {"RightLowerArm", "RightHand"},
    {"LowerTorso", "LeftUpperLeg"},
    {"LeftUpperLeg", "LeftLowerLeg"},
    {"LeftLowerLeg", "LeftFoot"},
    {"LowerTorso", "RightUpperLeg"},
    {"RightUpperLeg", "RightLowerLeg"},
    {"RightLowerLeg", "RightFoot"}
}

local function createSkeletonLines()
    local lines = {}
    for _ = 1, #R15_BONES do
        local line = Drawing.new("Line")
        line.Visible = false
        line.Thickness = 2
        line.Transparency = 0.9
        table.insert(lines, line)
    end
    return lines
end

local function removeSkeletonLines(lines)
    if lines then
        for _, line in ipairs(lines) do
            pcall(function() line:Remove() end)
        end
    end
end

local function clearAllSkeletons()
    for player, data in pairs(activeSkeletons) do
        removeSkeletonLines(data.Lines)
        activeSkeletons[player] = nil
    end
end

RunService.RenderStepped:Connect(function()
    if not espEnabled then
        clearAllSkeletons()
        return
    end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if isEnemy(player) then
            local character = player.Character
            if character and character:FindFirstChild("HumanoidRootPart") and character:FindFirstChild("Humanoid") and character.Humanoid.Health > 0 then
                
                if not activeSkeletons[player] then
                    activeSkeletons[player] = {
                        Lines = createSkeletonLines(),
                        Color = getRandomNeonColor()
                    }
                end
                
                local skeletonData = activeSkeletons[player]
                local lines = skeletonData.Lines
                local boneColor = skeletonData.Color
                
                local allVisible = true
                local projectedBones = {}
                
                for _, bonePair in ipairs(R15_BONES) do
                    local partA = character:FindFirstChild(bonePair[1])
                    local partB = character:FindFirstChild(bonePair[2])
                    
                    if partA and partB then
                        local posA, onScreenA = Camera:WorldToViewportPoint(partA.Position)
                        local posB, onScreenB = Camera:WorldToViewportPoint(partB.Position)
                        
                        if onScreenA or onScreenB then
                            table.insert(projectedBones, {Vector2.new(posA.X, posA.Y), Vector2.new(posB.X, posB.Y)})
                        else
                            allVisible = false
                            break
                        end
                    else
                        allVisible = false
                        break
                    end
                end
                
                if allVisible and #projectedBones == #R15_BONES then
                    for i, line in ipairs(lines) do
                        local boneCoords = projectedBones[i]
                        line.From = boneCoords[1]
                        line.To = boneCoords[2]
                        line.Color = boneColor
                        line.Visible = true
                    end
                else
                    for _, line in ipairs(lines) do
                        line.Visible = false
                    end
                end
            else
                if activeSkeletons[player] then
                    removeSkeletonLines(activeSkeletons[player].Lines)
                    activeSkeletons[player] = nil
                end
            end
        else
            if activeSkeletons[player] then
                removeSkeletonLines(activeSkeletons[player].Lines)
                activeSkeletons[player] = nil
            end
        end
    end
end)

Players.PlayerRemoving:Connect(function(player)
    if activeSkeletons[player] then
        removeSkeletonLines(activeSkeletons[player].Lines)
        activeSkeletons[player] = nil
    end
end)

